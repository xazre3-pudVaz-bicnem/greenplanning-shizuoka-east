# ───────────── アクセス制限（Basic認証） ─────────────
# 本部の確認・承認を得て公開するまでは、本番環境（Vercel）のすべてのページにBasic認証がかかります。
# 2つとも未設定の本番環境は、誰も閲覧できない状態（401）になります（設定漏れで公開されないため）。
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# ───────────── 公開URL ─────────────
# 本番URL（オリジンのみ）。未設定のあいだは canonical / OG / sitemap を出さず、robots.txt を Disallow にします。
NEXT_PUBLIC_SITE_URL=https://example.com

# ───────────── 一般公開のスイッチ ─────────────
# 既定は非公開（未設定・true 以外はすべて非公開扱い）。
# true にすると Basic認証が外れ、meta robots / robots.txt / sitemap.xml / X-Robots-Tag がまとめて公開側に切り替わります。
# 本部チェックリスト「公開・大幅変更」により、true にできるのは本部の確認・承認を得たあとだけです。
# 次がそろっていないと、true にしてもビルドが失敗します。
#   - HQ_APPROVAL_NOTE に承認の記録がある
#   - src/data/shop.ts の partnerCategory（本部指定のパートナー区分）が確定している
#   - 画面に「要確認」の項目が残っていない
NEXT_PUBLIC_ALLOW_INDEXING=false
# 本部の確認・承認の記録（例：2026-10-01 本部○○様よりメールで承認）
HQ_APPROVAL_NOTE=

# ───────────── 計測 ─────────────
# Google Analytics 4 の測定ID（G-XXXXXXXXXX）。未設定なら計測タグを出しません。
NEXT_PUBLIC_GA_ID=
# Google Search Console の HTMLタグ認証の content 値。未設定なら meta を出しません。
NEXT_PUBLIC_GSC_VERIFICATION=

# ───────────── お問い合わせフォームのメール送信 ─────────────
# Resend（https://resend.com）の API キー。未設定のときフォームは「メール未設定」を返し、
# 画面には電話・メールでの連絡先を案内します。
RESEND_API_KEY=
# 送信元（Resend で認証済みのドメインのアドレス）
MAIL_FROM="グリーンプランニング静岡EAST <no-reply@example.com>"
# 受信先（省略時は shizuoka-east@greenplanning.jp）
MAIL_TO=shizuoka-east@greenplanning.jp
