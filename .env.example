# ───────────── 公開URL ─────────────
# 本番URL（オリジンのみ）。未設定のあいだは canonical / OG / sitemap を出さず、
# robots.txt を Disallow にして、プレビューURLが検索結果に出ないようにしています。
NEXT_PUBLIC_SITE_URL=https://example.com

# ───────────── 計測 ─────────────
# Google Analytics 4 の測定ID（G-XXXXXXXXXX）。未設定なら計測タグを出しません。
NEXT_PUBLIC_GA_ID=
# Google Search Console の HTMLタグ認証の content 値。未設定なら meta を出しません。
NEXT_PUBLIC_GSC_VERIFICATION=

# ───────────── お問い合わせ・写真見積りフォームのメール送信 ─────────────
# Resend（https://resend.com）の API キー。未設定のときフォームは「メール未設定」を返し、
# 画面には電話・メールでの連絡先を案内します。
RESEND_API_KEY=
# 送信元（Resend で認証済みのドメインのアドレス）
MAIL_FROM="グリーンプランニング静岡EAST <no-reply@example.com>"
# 受信先（省略時は shizuoka-east@greenplanning.jp）
MAIL_TO=shizuoka-east@greenplanning.jp

# ───────────── ブログ自動生成（GitHub Actions からのみ使用） ─────────────
ANTHROPIC_API_KEY=
# 使用モデル。未設定なら claude-haiku-4-5 が使われます。
CLAUDE_MODEL=claude-haiku-4-5
